# Test binaries and coverage.
*.test
*.out
coverage.*
*.coverprofile

# Multi-module development: each nested module builds against the core
# through a replace directive, so a workspace file is never needed and
# never committed (it would hide a broken require).
go.work
go.work.sum

# AI assistant working state — never committed to this repo.
.claude/

# Local environment overrides.
.env
.env.local

# Editor / IDE noise.
.idea/
.vscode/
.DS_Store
*.swp
